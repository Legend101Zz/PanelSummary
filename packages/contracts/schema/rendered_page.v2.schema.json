{
  "$defs": {
    "CompiledPageLayout": {
      "additionalProperties": false,
      "properties": {
        "adjacency": {
          "items": {
            "$ref": "#/$defs/PanelAdjacency"
          },
          "maxItems": 190,
          "title": "Adjacency",
          "type": "array"
        },
        "compiler_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Compiler Hash",
          "type": "string"
        },
        "layout_engine_version": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Layout Engine Version",
          "type": "string"
        },
        "page_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Page Plan Id",
          "type": "string"
        },
        "panels": {
          "items": {
            "$ref": "#/$defs/CompiledPanelGeometry"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Panels",
          "type": "array"
        },
        "schema_version": {
          "const": "compiled-layout.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "page_plan_id",
        "layout_engine_version",
        "compiler_hash",
        "panels"
      ],
      "title": "CompiledPageLayout",
      "type": "object"
    },
    "CompiledPanelGeometry": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/NormalizedBox"
        },
        "clip_path": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Clip Path",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "polygon": {
          "items": {
            "$ref": "#/$defs/NormalizedPoint"
          },
          "maxItems": 32,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "read_rank": {
          "maximum": 999,
          "minimum": 0,
          "title": "Read Rank",
          "type": "integer"
        },
        "z_index": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "panel_id",
        "node_id",
        "polygon",
        "bbox",
        "clip_path",
        "read_rank"
      ],
      "title": "CompiledPanelGeometry",
      "type": "object"
    },
    "FreeformPanelLayoutNode": {
      "additionalProperties": false,
      "properties": {
        "exception_reason": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Exception Reason",
          "type": "string"
        },
        "kind": {
          "const": "freeform_panel",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "polygon": {
          "items": {
            "$ref": "#/$defs/NormalizedPoint"
          },
          "maxItems": 16,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "node_id",
        "panel_id",
        "polygon",
        "exception_reason"
      ],
      "title": "FreeformPanelLayoutNode",
      "type": "object"
    },
    "MangaPagePlan": {
      "additionalProperties": false,
      "properties": {
        "canvas": {
          "$ref": "#/$defs/PageCanvas"
        },
        "layout_root": {
          "discriminator": {
            "mapping": {
              "freeform_panel": "#/$defs/FreeformPanelLayoutNode",
              "overlay": "#/$defs/OverlayLayoutNode",
              "panel": "#/$defs/PanelLayoutNode",
              "split": "#/$defs/SplitLayoutNode"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PanelLayoutNode"
            },
            {
              "$ref": "#/$defs/SplitLayoutNode"
            },
            {
              "$ref": "#/$defs/OverlayLayoutNode"
            },
            {
              "$ref": "#/$defs/FreeformPanelLayoutNode"
            }
          ],
          "title": "Layout Root"
        },
        "page_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Page Plan Id",
          "type": "string"
        },
        "page_script": {
          "$ref": "#/$defs/PageScript"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "reading_direction": {
          "enum": [
            "rtl",
            "ltr"
          ],
          "title": "Reading Direction",
          "type": "string"
        },
        "reading_edges": {
          "items": {
            "$ref": "#/$defs/ReadingEdge"
          },
          "maxItems": 32,
          "title": "Reading Edges",
          "type": "array"
        },
        "schema_version": {
          "const": "manga-page-plan.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "script_set_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Script Set Artifact Id",
          "type": "string"
        },
        "source_fact_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Source Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "page_plan_id",
        "project_id",
        "script_set_artifact_id",
        "canvas",
        "reading_direction",
        "page_script",
        "layout_root"
      ],
      "title": "MangaPagePlan",
      "type": "object"
    },
    "NormalizedBox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "NormalizedBox",
      "type": "object"
    },
    "NormalizedPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "NormalizedPoint",
      "type": "object"
    },
    "OverlayInset": {
      "additionalProperties": false,
