{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://scrollstack.dev/contracts/qa_report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable per-attempt gate verdict (qa-report.v1, Session 6 issue #7):\naccepted AND rejected attempts persist their full gate state.",
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "at": {
      "maxLength": 500,
      "minLength": 1,
      "title": "At",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "gate_policy_version": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Gate Policy Version",
      "type": "string"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Gates",
      "type": "object"
    },
    "page_index": {
      "maximum": 999,
      "minimum": 0,
      "title": "Page Index",
      "type": "integer"
    },
    "page_plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Page Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "qa-report.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "page_plan_id",
    "page_index",
    "attempt",
    "gate_policy_version",
    "accepted",
    "gates",
    "at"
  ],
  "title": "QaReport",
  "type": "object"
}
