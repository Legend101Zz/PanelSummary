{
  "$defs": {
    "EvalPageScore": {
      "additionalProperties": false,
      "description": "Per-page structural + judge metrics inside a scorecard.",
      "properties": {
        "border_adherence_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Border Adherence Score"
        },
        "judge": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        },
        "judge_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Judge Cost Usd",
          "type": "number"
        },
        "layout_iou": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Iou"
        },
        "notes": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Notes",
          "type": "array"
        },
        "ocr_clean": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Clean"
        },
        "page_index": {
          "maximum": 999,
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        }
      },
      "required": [
        "page_index"
      ],
      "title": "EvalPageScore",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "https://scrollstack.dev/contracts/eval_scorecard.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Diffable eval-harness verdict for one run/lane/subject\n(eval-scorecard.v1). Metric and rubric versions ride the payload so\ncross-version comparisons can refuse loudly.",
  "properties": {
    "extra": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extra"
    },
    "harness_version": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Harness Version",
      "type": "string"
    },
    "judge_rubric_version": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Judge Rubric Version",
      "type": "string"
    },
    "lane": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Lane",
      "type": "string"
    },
    "layout_iou_version": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Layout Iou Version",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/EvalPageScore"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-scorecard.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "totals": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Totals",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "harness_version",
    "layout_iou_version",
    "judge_rubric_version",
    "project_id",
    "run_id",
    "lane",
    "subject",
    "pages",
    "totals"
  ],
  "title": "EvalScorecard",
  "type": "object"
}
