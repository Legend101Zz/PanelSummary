      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Panels",
      "type": "array"
    },
    "raster_asset_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
