            "standard",
            "borderless",
            "broken"
          ],
          "title": "Border Style",
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/NormalizedBox"
        },
        "node": {
          "discriminator": {
            "mapping": {
              "freeform_panel": "#/$defs/FreeformPanelLayoutNode",
              "overlay": "#/$defs/OverlayLayoutNode",
              "panel": "#/$defs/PanelLayoutNode",
              "split": "#/$defs/SplitLayoutNode"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PanelLayoutNode"
            },
            {
              "$ref": "#/$defs/SplitLayoutNode"
            },
            {
              "$ref": "#/$defs/OverlayLayoutNode"
            },
            {
              "$ref": "#/$defs/FreeformPanelLayoutNode"
            }
          ],
          "title": "Node"
        },
        "z_index": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "node",
        "anchor",
        "box",
        "z_index"
      ],
      "title": "OverlayInset",
      "type": "object"
    },
    "OverlayLayoutNode": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "discriminator": {
            "mapping": {
              "freeform_panel": "#/$defs/FreeformPanelLayoutNode",
