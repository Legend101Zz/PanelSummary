        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "page_end": {
          "minimum": 1,
          "title": "Page End",
          "type": "integer"
        },
        "page_start": {
          "minimum": 1,
          "title": "Page Start",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_unit_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Unit Id",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        },
        "text_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        }
      },
      "required": [
        "book_id",
        "source_unit_id",
        "page_start",
        "page_end",
        "text_hash"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SplitGutter": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "page_pct",
          "default": "page_pct",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 0.1,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "SplitGutter",
      "type": "object"
    },
    "SplitLayoutNode": {
      "additionalProperties": false,
      "properties": {
        "angle_deg": {
          "default": 0,
          "maximum": 18.0,
          "minimum": -18.0,
          "title": "Angle Deg",
          "type": "number"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ],
          "title": "Axis",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "freeform_panel": "#/$defs/FreeformPanelLayoutNode",
                "overlay": "#/$defs/OverlayLayoutNode",
                "panel": "#/$defs/PanelLayoutNode",
                "split": "#/$defs/SplitLayoutNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PanelLayoutNode"
              },
              {
                "$ref": "#/$defs/SplitLayoutNode"
              },
              {
                "$ref": "#/$defs/OverlayLayoutNode"
              },
              {
                "$ref": "#/$defs/FreeformPanelLayoutNode"
              }
            ]
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Children",
          "type": "array"
        },
        "gutter": {
          "$ref": "#/$defs/SplitGutter"
        },
        "kind": {
          "const": "split",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "ratios": {
          "items": {
            "exclusiveMinimum": 0.0,
            "maximum": 100.0,
            "type": "number"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Ratios",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "node_id",
        "axis",
        "ratios",
        "gutter",
        "children"
      ],
      "title": "SplitLayoutNode",
      "type": "object"
    },
    "SubjectBlocking": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/NormalizedPoint"
        },
        "depth": {
          "default": "midground",
          "enum": [
            "foreground",
            "midground",
            "background"
          ],
          "title": "Depth",
          "type": "string"
        },
        "expression": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "facing": {
          "default": "front",
          "enum": [
            "left",
            "right",
            "front",
            "away"
          ],
          "title": "Facing",
          "type": "string"
        },
        "pose": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Pose",
          "type": "string"
        },
        "scale": {
          "default": 1,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Scale",
          "type": "number"
        },
        "subject_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Ref",
          "type": "string"
        }
      },
      "required": [
        "subject_ref",
        "pose",
        "expression",
        "anchor"
      ],
      "title": "SubjectBlocking",
      "type": "object"
    },
    "TextElement": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "emotion": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emotion"
        },
        "kind": {
          "enum": [
            "dialogue",
            "thought",
            "narration",
            "monologue",
            "sfx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "overflow": {
          "default": "reject",
          "enum": [
            "fit",
            "reflow",
            "split",
            "reject"
          ],
          "title": "Overflow",
          "type": "string"
        },
        "panel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Panel Id",
          "type": "string"
        },
        "preferred_region": {
          "$ref": "#/$defs/NormalizedBox"
        },
        "shape": {
          "enum": [
            "oval",
            "round_rect",
            "thought_cloud",
            "jagged",
            "caption",
            "free_sfx"
          ],
          "title": "Shape",
          "type": "string"
        },
        "speaker_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Ref"
        },
        "tail_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextTailTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Text Id",
          "type": "string"
        },
        "typography": {
          "$ref": "#/$defs/TextTypography"
        },
        "writing_direction": {
          "default": "horizontal",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Writing Direction",
          "type": "string"
        },
        "z_index": {
          "default": 40,
          "maximum": 1000,
          "minimum": 0,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "text_id",
        "panel_id",
        "kind",
        "content",
        "shape",
        "preferred_region",
        "typography"
      ],
      "title": "TextElement",
      "type": "object"
    },
    "TextTailTarget": {
      "additionalProperties": false,
      "properties": {
        "point": {
          "$ref": "#/$defs/NormalizedPoint"
        },
        "subject_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Ref"
        }
      },
      "required": [
        "point"
      ],
      "title": "TextTailTarget",
      "type": "object"
    },
    "TextTypography": {
      "additionalProperties": false,
      "properties": {
        "emphasis": {
          "default": "normal",
          "enum": [
            "normal",
            "bold",
            "whisper",
            "shout"
          ],
          "title": "Emphasis",
          "type": "string"
        },
        "font_token": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Font Token",
          "type": "string"
        },
        "max_px": {
          "default": 48,
          "maximum": 256,
          "minimum": 8,
          "title": "Max Px",
          "type": "integer"
        },
        "min_px": {
          "default": 18,
          "maximum": 128,
          "minimum": 8,
          "title": "Min Px",
          "type": "integer"
        },
        "weight": {
          "default": 500,
          "maximum": 900,
          "minimum": 100,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "font_token"
      ],
      "title": "TextTypography",
      "type": "object"
    }
  },
  "$id": "https://scrollstack.dev/contracts/rendered_page.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessible_text": {
      "items": {
