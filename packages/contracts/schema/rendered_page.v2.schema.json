      },
      "maxItems": 8,
      "title": "Raster Asset Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "rendered-page.v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "page_plan",
    "compiled_layout",
    "panels",
    "canonical_svg_asset_id"
  ],
  "title": "RenderedPageV2",
  "type": "object"
}
